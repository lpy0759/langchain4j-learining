<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.pyliu</groupId>
    <artifactId>langchain4j-learining</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>langchain4j-learning</name>
    <description>LangChain4j 学习项目：从简单到复杂，按模块组织，每个模块一个 Maven 子项目</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <langchain4j.version>1.23.0</langchain4j.version>
        <slf4j.version>2.0.16</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- LangChain4j BOM：统一所有 langchain4j-* 依赖的版本 -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 简单日志实现，用于在控制台观察请求/响应 -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 直接放在 plugins 中，让所有子模块继承，确保 -parameters（保留方法参数名）生效 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <modules>
        <module>01-hello-world</module>
        <module>02-prompt-and-message</module>
        <module>03-ai-services</module>
        <module>04-chat-memory</module>
        <module>05-structured-output</module>
        <module>06-tools</module>
        <module>07-agent</module>
        <module>08-streaming</module>
        <module>09-embeddings</module>
        <module>10-rag-basic</module>
        <module>11-rag-advanced</module>
        <module>12-spring-boot</module>
        <module>13-observability</module>
        <module>14-multimodal</module>
    </modules>
</project>
